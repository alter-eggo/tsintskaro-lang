# Telegram Bot Tokens
TELEGRAM_BOT_TOKEN=your_production_bot_token
TELEGRAM_BOT_TOKEN_DEV=your_development_bot_token

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key

# Models by task. Smaller models keep extraction and summaries inexpensive.
OPENAI_MODEL_BOT=gpt-5.4-mini
OPENAI_MODEL_EXTRACTION=gpt-5.4-nano
OPENAI_MODEL_REPORT=gpt-5.4-mini

# Output caps include visible output and reasoning tokens.
OPENAI_MAX_COMPLETION_TOKENS_BOT=800
OPENAI_MAX_COMPLETION_TOKENS_EXTRACTION=3000
OPENAI_MAX_COMPLETION_TOKENS_REPORT=4000

# Message threshold before auto-generating report (default: 100)
MESSAGE_THRESHOLD=100

# Environment (development/production)
NODE_ENV=development

# Postgres connection string for poll storage
# For managed Postgres with self-signed certs (e.g. DigitalOcean), append &uselibpqcompat=true
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require&uselibpqcompat=true

# Set to "true" to run scheduled polls in development (off by default)
POLL_ENABLE_IN_DEV=false

# Set to "true" to run fact of the day in development (off by default)
FACT_DAY_ENABLE_IN_DEV=false

# Set to "true" to run scheduled word review in development (off by default)
WORD_REVIEW_ENABLE_IN_DEV=false

# Set to "true" to send OpenAI token reports in development (off by default)
OPENAI_USAGE_REPORT_ENABLE_IN_DEV=false

# Optional fallback target for daily OpenAI token reports.
# Prefer /settokenreport in Telegram so the bot stores the current chat/user id.
OPENAI_USAGE_REPORT_CHAT_ID=
OPENAI_USAGE_REPORT_THREAD_ID=
